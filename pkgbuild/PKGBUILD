# Maintainer: David Pietrzak <https://github.com/dtpietrzak>

# The local build used by bin/install. The recipe for the Omarchy package
# repository is packaging/omarchy-pkgs/stream-all/PKGBUILD; keep pkgver,
# pkgdesc, and depends the same in both.
pkgname=stream-all
pkgver=0.1.0
pkgrel=4
pkgdesc='Send one OBS stream to YouTube, Twitch, and any other RTMP destination'
arch=('x86_64' 'aarch64')
url='https://github.com/dtpietrzak/omarchy-stream-all'
license=('MIT')
options=('!debug')
depends=(
  'ffmpeg'
  'hicolor-icon-theme'
  'libsecret'
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
)
optdepends=('gnome-keyring: where stream keys are stored encrypted')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/stream-all "$pkgdir/usr/bin/stream-all"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/stream-all.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/stream-all.svg"
  install -Dm644 "$startdir/stream-all.desktop" "$pkgdir/usr/share/applications/stream-all.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
